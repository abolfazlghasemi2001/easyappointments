# ---------------------------------------------------------------------------
# Easy!Appointments fork - environment configuration example
#
# Copy this file to ".env" on the server and fill in the real values:
#
#     cp .env.example .env && chmod 600 .env && nano .env
#
# The ".env" file must never be committed (it is listed in .gitignore) and the
# values must never appear in the README, in the logs, in the chat or in a
# repository. This example contains placeholders only.
#
# The root "config.php" of the installation must contain a single line:
#
#     <?php require_once __DIR__ . '/config-loader.php';
#
# "config-loader.php" reads this file, fills $_ENV and defines the Config class
# (and the optional ENCRYPTION_KEY constant) from the values below.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------

# "production" disables the debug output and the verbose error pages.
APP_ENV=production

# Public address of the installation, without a trailing slash. It is used by
# the console/cron commands and by the "base_url" fallback.
APP_URL=https://nobat.hoosna1402.ir

# Default language of the application (english, persian, ...).
APP_LANGUAGE=persian

# Never enable this on a production installation.
DEBUG_MODE=false

# Strong random string (>= 32 characters), for example:
#   openssl rand -hex 32
ENCRYPTION_KEY=

# --- Database --------------------------------------------------------------

# Inside docker compose the host is the service name "db".
DB_HOST=db
DB_NAME=easyappointments
DB_USERNAME=easyappointments
DB_PASSWORD=

# MySQL credentials of the database container (docker compose reads them from
# this same file). MYSQL_ROOT_PASSWORD must not be empty.
MYSQL_ROOT_PASSWORD=

# --- Web / TLS -------------------------------------------------------------

# Host port of the nginx service. It is bound to 127.0.0.1 only, because a
# reverse proxy (Caddy) is the only component that talks to the internet.
APP_HTTP_PORT=8080

# Domain of the Caddyfile in deploy/Caddyfile.
APP_DOMAIN=nobat.hoosna1402.ir

# --- SMS / TextBee (steps 3 and 4) -----------------------------------------

# Which SMS driver is used: "mock" (writes to the log, sends nothing) or "textbee".
SMS_DRIVER=mock

# TextBee credentials (https://textbee.dev) - required when SMS_DRIVER=textbee.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Optional overrides.
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
# Full "send message" URL, for self hosted installations that use the device scoped endpoint.
TEXTBEE_SEND_URL=
TEXTBEE_TIMEOUT=20
TEXTBEE_MAX_ATTEMPTS=3
TEXTBEE_BACKOFF_MS=1000

# --- Maintenance endpoints (cron) ------------------------------------------

# When the key is empty, only requests from the loopback address (or the console) are accepted.
BOOKING_MAINTENANCE_KEY=
SMS_MAINTENANCE_KEY=

# --- Backups ---------------------------------------------------------------

# Directory that the backup/restore scripts write to (on the host).
BACKUP_DIR=/var/backups/easyappointments

# Number of daily backups that are kept before the oldest ones are deleted.
BACKUP_RETENTION_DAYS=14
