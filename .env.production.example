# Copy to .env on the server, set real secrets, then chmod 600 .env.
# Never commit .env or place production passwords in config.php or chat.

# Public host served by Caddy; DNS A record must point here before startup.
APP_DOMAIN=nobat.hoosna1402.ir
APP_URL=https://nobat.hoosna1402.ir
APP_ENV=production
APP_DEBUG=0
APP_IMAGE_TAG=production
# Use a new immutable value for each frontend release (for example, a short git SHA).
APP_ASSET_VERSION=replace-with-release-id

# Use long, unique secrets (for example: openssl rand -hex 32).
MYSQL_ROOT_PASSWORD=replace-with-a-unique-random-root-secret
MYSQL_DATABASE=easyappointments
MYSQL_USER=ea_app
MYSQL_PASSWORD=replace-with-a-different-unique-random-app-secret

# SMS is disabled until explicitly configured. Never leave mock as the live SMS driver.
SMS_DRIVER=mock
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
TEXTBEE_TIMEOUT=20
TEXTBEE_MAX_ATTEMPTS=3
TEXTBEE_BACKOFF_MS=1000

# Leave empty to allow only the local host/CLI to run maintenance endpoints.
BOOKING_MAINTENANCE_KEY=
SMS_MAINTENANCE_KEY=
